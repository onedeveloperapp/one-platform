{
  "name": "@flyee/courts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Court integrations behind interfaces, each with a real implementation, a fake and a contract test. The DJEN communications client, the rule of a filing package, and the sources of the course of a lawsuit (TJGO's Projudi webservice, the Escavador and Judit aggregators) with their comparative test.",
  "exports": {
    ".": "./src/index.ts",
