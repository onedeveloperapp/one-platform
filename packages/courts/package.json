    "./filing": "./src/filing.ts",
    "./oab": "./src/oab.ts",
    "./providers/djen": "./src/providers/djen.ts",
    "./providers/projudi": "./src/providers/projudi.ts",
    "./providers/mni": "./src/providers/mni.ts",
    "./providers/aggregator-http": "./src/providers/aggregator-http.ts",
    "./providers/escavador": "./src/providers/escavador.ts",
    "./providers/judit": "./src/providers/judit.ts",
    "./xml": "./src/xml.ts",
    "./compare": "./src/compare.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/contract.test.ts src/filing.test.ts src/proceedings.test.ts src/filing-channel.test.ts"
  }
}
