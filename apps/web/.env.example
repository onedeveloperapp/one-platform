# ONE platform: environment reference. Copy to .env.local and fill with ONE
# development or sandbox values. Every key may stay empty: the app builds and
# serves the public site without any of them.
#
# NEVER point these at another product's services: the db:*:remote scripts
# migrate whatever DATABASE_URL names.

# Canonical site URL in production, no trailing slash (sitemap/robots/OG/JSON-LD
# fall back to http://localhost:3000 without it).
NEXT_PUBLIC_SITE_URL=
# Cookie/localStorage key prefix.
NEXT_PUBLIC_STORAGE_PREFIX="one"
NEXT_PUBLIC_MUI_X_LICENSE_KEY="YOUR_MUIX_LICENSE_KEY"

# --- Supabase (empty: the public site works, forms say they are unavailable
# and the logged area redirects to sign-in, where nobody can sign in) ---
# Project URL and anon key: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Pooled connection string (port 6543) for @flyee/db and the
# remote migration gate (scripts/remote-db-gate.mjs).
DATABASE_URL=
# Server-only. Service role key: never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing of the ONE subscription (optional) ---
# Asaas charges BRL. The Stripe keys belong to the inherited USD path, which
# leaves with the subscription tiers (M3): keep them empty.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Default: Asaas sandbox. Production: https://api.asaas.com/v3
ASAAS_BASE_URL=
# Pix kill switch: "false" hides Pix. Empty = ask the Asaas account whether it
# has an active Pix key.
BILLING_PIX_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Ads & analytics of the PUBLIC site (optional; empty = no tracker loads,
# banner stays hidden). No tracker ever runs inside the logged area. ---
# Meta Pixel: Events Manager > Data sources > your dataset > "Pixel ID".
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 Measurement ID (G-XXXXXXXXXX): GA Admin > Data streams > Web stream.
NEXT_PUBLIC_GA4_ID=
# Server-only. GA4 Measurement Protocol API secret (lib/ga4-mp.ts).
GA4_API_SECRET=
# Server-only. Meta Conversions API access token (lib/meta-capi.ts).
META_CAPI_TOKEN=
# Optional. Test-events code (Events Manager > Test events) to verify CAPI live.
META_CAPI_TEST_EVENT_CODE=

# --- AI (server-only). A task runs on the provider its prompt version names;
# with no key for that provider the run is recorded as failed. ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# "1" makes a fake provider answer every task, with no key and no network: for
# a development machine or a preview. Its runs are recorded under the model
# name "fake". Ignored in production (VERCEL_ENV=production).
AI_FAKE_PROVIDER=

# --- The vault of the firms' vendor tokens (server-only; migration 0017) ---
# version:base64 of 32 random bytes, comma separated; the highest version seals,
# every listed version opens. To rotate: add the next version first, let the
# daily upkeep reseal everything, then remove the old one. A new key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never put a lawyer's password, PIN or certificate anywhere: the vault refuses them.
VAULT_KEYS=

# --- WhatsApp (server-only; migration 0019). Each firm connects its own number;
# what is here is the PLATFORM's own app at Meta, never a firm's token (those
# are sealed in the vault). All four are needed for a real number. ---
# The app's id and secret (Meta for Developers > App settings > Basic). The
# secret also signs every webhook delivery: without it no delivery is taken.
META_APP_ID=
META_APP_SECRET=
# The Embedded Signup configuration the connection window opens with
# (Facebook Login for Business > Configurations).
META_SIGNUP_CONFIG_ID=
# Any long random string. Type the same one at Meta when registering the
# webhook address: https://<your-domain>/api/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# "1" turns on the simulator: a number that exists only here, with a panel that
# plays the person and the firm's phone. No message leaves the environment. For
# a development machine or a preview; needs VAULT_KEYS like a real number.
# Ignored in production (VERCEL_ENV=production).
WHATSAPP_SIMULATOR=

# --- The CPF registry (server-only; migration 0022, packages/identity) ---
# The PLATFORM's contract with Serpro (Consulta CPF v3), never a firm's: the
# consumer key and secret from the Serpro customer area. Without them the
# "Consultar CPF" button of a case says the lookup is not on here.
# "trial" points at Serpro's demonstration environment (fictitious CPFs, not
# billed); anything else is production, where every answer is billed.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_ENVIRONMENT=

# --- Background jobs (optional; without keys, work falls back to inline) ---
# Local dev needs no keys: run "npx inngest-cli dev".
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Backups (@flyee/backup; needs DATABASE_URL + SUPABASE_SERVICE_ROLE_KEY) ---
# Days to keep backup runs and their archives before pruning (default 30).
BACKUP_RETENTION_DAYS=

# --- Transactional email (optional; callers fall back without it) ---
# Server-only. https://resend.com API key.
RESEND_API_KEY=
# Verified sender, e.g. "ONE <nao-responda@seu-dominio.com.br>"
EMAIL_FROM=
# Where the public contact form is delivered.
CONTACT_FORM_TO=

# --- Public forms (waitlist) ---
# Server-only secret that pseudonymizes the visitor's network (HMAC of the IP)
# for the waitlist's per-network sign-up window. Without it there is no window.
# Any long random string; changing it only resets the window.
PUBLIC_FORMS_IP_SALT=

# DJEN: the national electronic gazette of the courts, read through its public API (no key) for the
# registrations at the bar of each firm's lawyers. Production reads it unless this is 0; anywhere else it
# is read only with 1. Leave blank on a development machine: an invented registration may be a real
# lawyer's number, and it is not read for by accident.
DJEN_CAPTURE=

# REDEMET (DECEA): the weather reports of Brazilian airports, read for the Tema 1.417 triage of a case.
# The key is the platform's, from the registration at https://api-redemet.decea.mil.br/cadastro-api/.
# Blank: the case screen says the reading is not on, and no report is invented.
REDEMET_API_KEY=

# FlightAware AeroAPI: what happened to a flight anywhere, asked by a person of a firm about a leg that ANAC's
# official record cannot answer yet (a flight of the last weeks, a leg abroad). The key is the platform's, from
# https://www.flightaware.com/aeroapi/ (each answer is billed by FlightAware; the database limits the asking).
# Blank: the case screen does not offer the lookup, and the official record is checked all the same.
FLIGHTAWARE_API_KEY=

# --- The course of the lawsuits (migration 0031) ---
# Whether this environment reads the courts: TJGO's Projudi (public, no key) and the aggregator below. On in
# production unless 0; anywhere else only with 1 (an invented lawsuit number may be somebody's real one).
COURT_TRACKING=
# The aggregator of the courts outside Goiás, chosen by the comparative test (packages/courts/scripts/compare-sources.ts):
# escavador or judit, with its key. Blank: those lawsuits wait, and their case says why.
COURT_AGGREGATOR=
ESCAVADOR_API_TOKEN=
JUDIT_API_KEY=

# --- The firm's calendar of hearings (migration 0037, packages/calendar) ---
# The platform's OAuth client at Google (a Google Cloud project with the Calendar API on; the consent screen asks
# for the scope calendar.app.created only, and its redirect is <site>/api/connections/google/callback). While the
# consent screen is in Testing, a firm's grant ends after seven days and the firm connects again.
# Blank: the connection of a calendar does not show, and the agenda works without Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 1 on a development machine or a preview: a calendar in memory that consents at once. Never honoured in production.
CALENDAR_FAKE=

# --- A lawyer's signature in the cloud (migration 0041, packages/psc) ---
# The platform's own client at each PSC (a provider of ICP-Brasil certificates in the cloud), registered at that PSC
# with ONE's ICP-Brasil SSL certificate; its redirect is <site>/api/connections/psc/callback. One pair per PSC of
# the table psc_providers, named by its slug in capitals: PSC_SERPROID_CLIENT_ID, PSC_BIRDID_CLIENT_ID and so on.
# A PSC with no pair is not offered. What a lawyer authorizes is sealed with VAULT_KEYS and lives at most 7 days.
PSC_SERPROID_CLIENT_ID=
PSC_SERPROID_CLIENT_SECRET=
PSC_BIRDID_CLIENT_ID=
PSC_BIRDID_CLIENT_SECRET=
# 1 on a development machine or a preview: a PSC in memory stands where every PSC of the list stands, consents at
# once and signs with an invented certificate. Never honoured in production.
PSC_FAKE=
